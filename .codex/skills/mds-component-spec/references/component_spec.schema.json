{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/mds/component_spec.schema.json",
  "title": "MDS Component Spec",
  "type": "object",
  "required": [
    "meta",
    "scope",
    "pipeline",
    "ui",
    "state",
    "events",
    "backend_contracts"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["component_id", "version", "target"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "target": {
          "type": "array",
          "items": {"type": "string"},
          "contains": {"const": "rust-maud"},
          "minItems": 2
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "pipeline": {
      "type": "object",
      "required": ["execution_order", "required_agents"],
      "properties": {
        "execution_order": {
          "type": "array",
          "items": {"type": "string", "pattern": "^mds-"},
          "minItems": 1
        },
        "required_agents": {
          "type": "array",
          "items": {"type": "string", "pattern": "^mds-"},
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "ui": {
      "type": "object",
      "required": ["event_dispatch", "nodes", "slots", "bindings"],
      "properties": {
        "event_dispatch": {
          "type": "object",
          "required": ["syntax", "description"],
          "properties": {
            "syntax": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "parent_id", "tag", "attrs"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "parent_id": {"type": ["string", "null"]},
              "tag": {"type": "string", "minLength": 1},
              "attrs": {
                "type": "object",
                "patternProperties": {
                  "^data-on:": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Allowed for UI-local reactivity. Verifier enforces authority constraints against app fields."
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "required"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node_id", "kind", "path"],
            "properties": {
              "node_id": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "state": {
      "type": "object",
      "required": ["fields", "derived", "persistence"],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "initial", "authority"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"type": "string", "minLength": 1},
              "initial": {},
              "authority": {
                "type": "string",
                "enum": ["ui", "app"]
              },
              "sync": {
                "type": "string",
                "enum": ["none", "optimistic", "authoritative"]
              }
            },
            "additionalProperties": true
          }
        },
        "derived": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "formula"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"type": "string", "minLength": 1},
              "formula": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        },
        "persistence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field_id", "storage"],
            "properties": {
              "field_id": {"type": "string", "minLength": 1},
              "storage": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "events": {
      "type": "object",
      "required": ["handlers", "ui_transitions", "app_mappings", "effects"],
      "properties": {
        "handlers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "class", "source_node_id", "trigger", "payload"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "class": {"type": "string", "enum": ["ui", "app"]},
              "source_node_id": {"type": "string", "minLength": 1},
              "trigger": {"type": "string", "minLength": 1},
              "payload": {"type": "object"}
            },
            "additionalProperties": true
          }
        },
        "ui_transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["handler_id", "updates"],
            "properties": {
              "handler_id": {"type": "string", "minLength": 1},
              "updates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["field_id", "value"],
                  "properties": {
                    "field_id": {"type": "string", "minLength": 1},
                    "value": {}
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "app_mappings": {
          "type": "object",
          "required": ["backend_responses", "sse_events"],
          "properties": {
            "backend_responses": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["action_id", "updates"],
                "properties": {
                  "action_id": {"type": "string", "minLength": 1},
                  "updates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["field_id", "value"],
                      "properties": {
                        "field_id": {"type": "string", "minLength": 1},
                        "value": {}
                      },
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "sse_events": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["event_name", "updates"],
                "properties": {
                  "event_name": {"type": "string", "minLength": 1},
                  "updates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["field_id", "value"],
                      "properties": {
                        "field_id": {"type": "string", "minLength": 1},
                        "value": {}
                      },
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["handler_id", "type"],
            "properties": {
              "handler_id": {"type": "string", "minLength": 1},
              "type": {"type": "string", "minLength": 1},
              "action_id": {"type": "string"}
            },
            "allOf": [
              {
                "if": {
                  "properties": {"type": {"const": "invoke_backend"}}
                },
                "then": {
                  "required": ["action_id"]
                }
              }
            ],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "backend_contracts": {
      "type": "object",
      "required": ["actions", "types", "validation"],
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "method", "path", "input_type", "output_type"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "method": {
                "type": "string",
                "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
              },
              "path": {"type": "string", "minLength": 1},
              "input_type": {"type": "string", "minLength": 1},
              "output_type": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        },
        "types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "fields"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "type": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "validation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "rule"],
            "properties": {
              "target": {"type": "string", "minLength": 1},
              "rule": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "override": {
      "type": "object",
      "required": ["reason", "approved_by", "sources"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "codegen": {
      "type": "object",
      "properties": {
        "files": {"type": "array"},
        "markers": {"type": "array"},
        "trace": {"type": "object"}
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["pass", "fail"]},
        "errors": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
