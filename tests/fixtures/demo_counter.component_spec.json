{
  "meta": {
    "component_id": "counter_widget",
    "version": "0.2.0",
    "target": [
      "rust-maud",
      "datastar"
    ]
  },
  "scope": {
    "description": "Counter widget with local UI count and server-authoritative sync state"
  },
  "pipeline": {
    "execution_order": [
      "mds-orchestrator",
      "mds-docs-librarian",
      "mds-ui-decomposer",
      "mds-cms-content-modeler",
      "mds-state-modeler",
      "mds-events-designer",
      "mds-backend-contracts",
      "mds-codegen",
      "mds-verifier"
    ],
    "required_agents": [
      "mds-orchestrator",
      "mds-docs-librarian",
      "mds-ui-decomposer",
      "mds-cms-content-modeler",
      "mds-state-modeler",
      "mds-events-designer",
      "mds-backend-contracts",
      "mds-codegen",
      "mds-verifier"
    ],
    "parallel_groups": [
      [
        "mds-ui-decomposer",
        "mds-cms-content-modeler",
        "mds-state-modeler",
        "mds-events-designer",
        "mds-backend-contracts"
      ]
    ]
  },
  "docs_lookup": {
    "paths": [
      "/docs/maud/index.md",
      "/docs/maud/render-trait.md",
      "/docs/datastar/reference/attributes.md",
      "/docs/datastar/reference/sse_events.md",
      "/docs/axum/response/sse/index.md"
    ]
  },
  "ui": {
    "event_dispatch": {
      "syntax": "@dispatch('<handler_id>')",
      "description": "Use semantic handler dispatch for event contracts; local Datastar expressions may mutate ui-authority fields."
    },
    "nodes": [
      {
        "id": "counter_root",
        "parent_id": null,
        "tag": "section",
        "attrs": {
          "id": "counter-widget",
          "class": "counter-widget",
          "data-signals": "{count: 0, server_count: 0, server_connected: false}"
        }
      },
      {
        "id": "count_value",
        "parent_id": "counter_root",
        "tag": "output",
        "attrs": {
          "class": "counter-value",
          "data-text": "$count"
        }
      },
      {
        "id": "server_count_value",
        "parent_id": "counter_root",
        "tag": "output",
        "attrs": {
          "class": "counter-server-value",
          "data-text": "$server_count"
        }
      },
      {
        "id": "increment_button",
        "parent_id": "counter_root",
        "tag": "button",
        "attrs": {
          "type": "button",
          "class": "counter-inc",
          "data-on:click": "$count = $count + 1; @post('/api/counter/sync', {delta: 1})"
        }
      },
      {
        "id": "decrement_button",
        "parent_id": "counter_root",
        "tag": "button",
        "attrs": {
          "type": "button",
          "class": "counter-dec",
          "data-on:click": "$count = $count - 1; @post('/api/counter/sync', {delta: -1})"
        }
      }
    ],
    "slots": [
      {
        "name": "controls",
        "required": false
      }
    ],
    "bindings": [
      {
        "node_id": "counter_root",
        "kind": "datastar-signal",
        "path": "count"
      },
      {
        "node_id": "server_count_value",
        "kind": "datastar-text",
        "path": "server_count"
      },
      {
        "node_id": "count_value",
        "kind": "datastar-text",
        "path": "count"
      },
      {
        "node_id": "increment_button",
        "kind": "datastar-event",
        "path": "click:increment"
      },
      {
        "node_id": "decrement_button",
        "kind": "datastar-event",
        "path": "click:decrement"
      }
    ]
  },
  "state": {
    "fields": [
      {
        "id": "count",
        "type": "integer",
        "initial": 0,
        "authority": "ui",
        "sync": "optimistic"
      },
      {
        "id": "server_count",
        "type": "integer",
        "initial": 0,
        "authority": "app",
        "sync": "authoritative"
      },
      {
        "id": "server_connected",
        "type": "boolean",
        "initial": false,
        "authority": "app",
        "sync": "authoritative"
      }
    ],
    "derived": [
      {
        "id": "delta",
        "type": "integer",
        "formula": "count - server_count"
      }
    ],
    "persistence": [
      {
        "field_id": "count",
        "storage": "session"
      }
    ]
  },
  "events": {
    "handlers": [
      {
        "id": "increment_click",
        "class": "ui",
        "source_node_id": "increment_button",
        "trigger": "click",
        "payload": {}
      },
      {
        "id": "decrement_click",
        "class": "ui",
        "source_node_id": "decrement_button",
        "trigger": "click",
        "payload": {}
      },
      {
        "id": "counter_update_event",
        "class": "app",
        "source_node_id": "counter_root",
        "trigger": "sse:datastar-patch-signals",
        "payload": {
          "server_count": "$event.server_count",
          "server_connected": "$event.server_connected"
        }
      }
    ],
    "ui_transitions": [
      {
        "handler_id": "increment_click",
        "updates": [
          {
            "field_id": "count",
            "value": "$state.count + 1"
          }
        ]
      },
      {
        "handler_id": "decrement_click",
        "updates": [
          {
            "field_id": "count",
            "value": "$state.count - 1"
          }
        ]
      }
    ],
    "app_mappings": {
      "backend_responses": [],
      "sse_events": [
        {
          "event_name": "datastar-patch-signals",
          "updates": [
            {
              "field_id": "server_count",
              "value": "$event.server_count"
            },
            {
              "field_id": "server_connected",
              "value": "$event.server_connected"
            }
          ]
        }
      ]
    },
    "effects": [
      {
        "handler_id": "increment_click",
        "type": "invoke_backend",
        "action_id": "sync_counter"
      },
      {
        "handler_id": "decrement_click",
        "type": "invoke_backend",
        "action_id": "sync_counter"
      }
    ]
  },
  "backend_contracts": {
    "actions": [
      {
        "id": "sync_counter",
        "method": "POST",
        "path": "/api/counter/sync",
        "input_type": "SyncCounterInput",
        "output_type": "SyncCounterCommandResult"
      },
      {
        "id": "counter_stream",
        "method": "GET",
        "path": "/api/counter/events",
        "input_type": "CounterStreamInput",
        "output_type": "CounterSignalPatch"
      }
    ],
    "types": [
      {
        "id": "SyncCounterInput",
        "fields": [
          {
            "name": "delta",
            "type": "integer"
          }
        ]
      },
      {
        "id": "SyncCounterCommandResult",
        "fields": []
      },
      {
        "id": "CounterStreamInput",
        "fields": [
          {
            "name": "component_id",
            "type": "string"
          }
        ]
      },
      {
        "id": "CounterSignalPatch",
        "fields": [
          {
            "name": "server_count",
            "type": "integer"
          },
          {
            "name": "server_connected",
            "type": "boolean"
          }
        ]
      }
    ],
    "validation": [
      {
        "target": "SyncCounterInput.delta",
        "rule": "min_value:-1,max_value:1"
      }
    ]
  },
  "verification": {
    "status": "pass",
    "errors": [],
    "warnings": [
      "persistence: ui field 'count' is persisted (verify policy intent)"
    ]
  },
  "codegen": {
    "files": [
      {
        "path": "generated/demo_counter/view.rs",
        "language": "rust"
      },
      {
        "path": "generated/demo_counter/state.rs",
        "language": "rust"
      },
      {
        "path": "generated/demo_counter/events.rs",
        "language": "rust"
      },
      {
        "path": "generated/demo_counter/handler.rs",
        "language": "rust"
      }
    ],
    "markers": [
      "BEGIN MDS GENERATED:component",
      "END MDS GENERATED:component",
      "BEGIN MDS GENERATED:state",
      "END MDS GENERATED:state",
      "BEGIN MDS GENERATED:events",
      "END MDS GENERATED:events",
      "BEGIN MDS GENERATED:handler",
      "END MDS GENERATED:handler"
    ],
    "trace": {
      "component_id": "counter_widget",
      "schema": "mds-component-spec@0.2.0",
      "execution_order": [
        "mds-orchestrator",
        "mds-docs-librarian",
        "mds-ui-decomposer",
        "mds-state-modeler",
        "mds-events-designer",
        "mds-backend-contracts",
        "mds-verifier",
        "mds-codegen"
      ]
    }
  },
  "content": {
    "source": "cms",
    "root_type": "CounterWidgetContent",
    "fixture_path": "tests/fixtures/cms/counter_widget.json",
    "notes": "Copy and labels are fixture-driven; template literals should stay placeholder/debug-only."
  },
  "design": {
    "reuse_scan": {
      "checked_components": [
        "crates/http/src/views/partials/components/mod.rs",
        "crates/http/src/views/partials/components/tab.rs",
        "crates/http/src/views/partials/components/tab_panel.rs"
      ],
      "reused": [],
      "created": [
        "counter_widget"
      ]
    }
  }
}
